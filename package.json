{
  "name": "gnester-lite",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"src/config/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "start": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:debug": "NODE_ENV=test vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.config.e2e.ts",
    "migration:run:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/src/infra/database/typeorm.data-source.js migration:run",
    "migration:revert:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/src/infra/database/typeorm.data-source.js migration:revert",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"src/config/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "lint:check": "oxlint --type-aware src/ test/",
    "typecheck": "pnpm run typecheck:build && pnpm run typecheck:test",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit --incremental false",
    "typecheck:test": "tsc --project tsconfig.json --noEmit --incremental false",
    "verify:artifact": "node scripts/verify-build-artifact.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:container-references": "node scripts/verify-container-references.mjs",
    "verify:docker-image": "node scripts/verify-docker-image.mjs",
    "verify:openapi": "node scripts/verify-openapi-document.mjs",
    "verify:shutdown-contract": "node scripts/verify-shutdown-contract.mjs",
    "verify:migrations": "node scripts/run-destructive-integration.mjs migrations",
    "verify:production-start": "node scripts/run-destructive-integration.mjs production-start",
    "audit:prod": "pnpm audit --prod",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "peers:check": "pnpm peers check",
    "test:full-app": "node scripts/run-destructive-integration.mjs full-app",
    "test:integration-policy": "node --test scripts/run-destructive-integration.test.mjs",
    "compodoc": "compodoc -p tsconfig.compodoc.json -d documentation --silent",
    "compodoc:serve": "compodoc -p tsconfig.compodoc.json -d documentation -s",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm run build && NODE_ENV=development node node_modules/typeorm/cli.js -d dist/src/infra/database/typeorm.data-source.js migration:generate",
    "migration:run": "pnpm run build && NODE_ENV=development node node_modules/typeorm/cli.js -d dist/src/infra/database/typeorm.data-source.js migration:run",
    "migration:revert": "pnpm run build && NODE_ENV=development node node_modules/typeorm/cli.js -d dist/src/infra/database/typeorm.data-source.js migration:revert",
    "start:repl": "NODE_ENV=development nest start --watch --entryFile repl",
    "test:architecture": "node --test scripts/verify-source-boundaries.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@casl/ability": "catalog:",
    "@keyv/redis": "catalog:",
    "@nestjs/axios": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/cache-manager": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@sentry/nestjs": "catalog:",
    "ai": "catalog:",
    "axios": "catalog:",
    "bullmq": "catalog:",
    "cache-manager": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "compression": "catalog:",
    "cookie-parser": "catalog:",
    "cron": "catalog:",
    "csrf-csrf": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "js-yaml": "catalog:",
    "mysql2": "catalog:",
    "nestjs-i18n": "catalog:",
    "nestjs-pino": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "typeorm": "catalog:"
  },
  "devDependencies": {
    "@compodoc/compodoc": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/compression": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/passport-jwt": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pino-pretty": "catalog:",
    "prettier": "catalog:",
    "source-map-support": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25"
  }
}
