{
  "name": "gnester-lite",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"config/**/*.{ts,yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"config/**/*.{ts,yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "start": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "start:repl": "NODE_ENV=development nest start --watch --entryFile repl",
    "lint": "eslint \"{src,apps,libs,test,config}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,config}/**/*.ts\"",
    "typecheck": "pnpm run typecheck:build && pnpm run typecheck:test",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit --incremental false",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit --incremental false",
    "verify:artifact": "node scripts/verify-build-artifact.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:container-references": "node scripts/verify-container-references.mjs",
    "verify:docker-image": "node scripts/verify-docker-image.mjs",
    "verify:openapi": "node scripts/verify-openapi-document.mjs",
    "verify:shutdown-contract": "node scripts/verify-shutdown-contract.mjs",
    "verify:migrations": "node scripts/run-destructive-integration.mjs migrations",
    "verify:production-start": "node scripts/run-destructive-integration.mjs production-start",
    "audit:prod": "pnpm audit --prod",
    "typeorm": "typeorm-ts-node-commonjs -d config/typeorm.data-source.ts",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:run:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/config/typeorm.data-source.js migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:revert:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/config/typeorm.data-source.js migration:revert",
    "peers:check": "pnpm peers check",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:full-app": "node scripts/run-destructive-integration.mjs full-app",
    "test:integration-policy": "node --test scripts/run-destructive-integration.test.mjs",
    "compodoc": "compodoc -p tsconfig.compodoc.json -d documentation --silent",
    "compodoc:serve": "compodoc -p tsconfig.compodoc.json -d documentation -s"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "@sentry/nestjs": "^10.68.0",
    "axios": "^1.18.1",
    "better-auth": "1.6.25",
    "bullmq": "^5.81.2",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "csrf-csrf": "^4.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.2.2",
    "mysql2": "^3.23.1",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.0",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "0.7.10",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "chokidar": "4.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/config"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^config/(.*)$": "<rootDir>/config/$1",
      "^\\./better-auth\\.loader\\.cjs$": "<rootDir>/test/fixtures/better-auth-loader.mock.cjs",
      "^better-auth$": "<rootDir>/test/fixtures/better-auth.mock.cjs",
      "^better-auth/node$": "<rootDir>/test/fixtures/better-auth-node.mock.cjs"
    },
    "transform": {
      "^.+\\.(t|j)s?$": [
        "@swc/jest"
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!src/metadata.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 70,
        "lines": 75,
        "statements": 70
      }
    },
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.1.2"
}
