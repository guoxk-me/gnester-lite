{
  "name": "gnester-lite",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"src/config/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "start": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test vitest run --coverage",
    "test:debug": "NODE_ENV=test vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test vitest run --config ./vitest.config.e2e.ts",
    "migration:run:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/src/config/typeorm.data-source.js migration:run",
    "migration:revert:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/src/config/typeorm.data-source.js migration:revert",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"src/config/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "lint:check": "oxlint --type-aware src/ test/",
    "typecheck": "pnpm run typecheck:build && pnpm run typecheck:test",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit --incremental false",
    "typecheck:test": "tsc --project tsconfig.json --noEmit --incremental false",
    "verify:artifact": "node scripts/verify-build-artifact.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:container-references": "node scripts/verify-container-references.mjs",
    "verify:docker-image": "node scripts/verify-docker-image.mjs",
    "verify:openapi": "node scripts/verify-openapi-document.mjs",
    "verify:shutdown-contract": "node scripts/verify-shutdown-contract.mjs",
    "verify:migrations": "node scripts/run-destructive-integration.mjs migrations",
    "verify:production-start": "node scripts/run-destructive-integration.mjs production-start",
    "audit:prod": "pnpm audit --prod",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "peers:check": "pnpm peers check",
    "test:full-app": "node scripts/run-destructive-integration.mjs full-app",
    "test:integration-policy": "node --test scripts/run-destructive-integration.test.mjs",
    "compodoc": "compodoc -p tsconfig.compodoc.json -d documentation --silent",
    "compodoc:serve": "compodoc -p tsconfig.compodoc.json -d documentation -s",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm run build && NODE_ENV=development node node_modules/typeorm/cli.js -d dist/src/config/typeorm.data-source.js migration:generate",
    "migration:run": "pnpm run build && NODE_ENV=development node node_modules/typeorm/cli.js -d dist/src/config/typeorm.data-source.js migration:run",
    "migration:revert": "pnpm run build && NODE_ENV=development node node_modules/typeorm/cli.js -d dist/src/config/typeorm.data-source.js migration:revert",
    "start:repl": "NODE_ENV=development nest start --watch --entryFile repl"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/platform-socket.io": "^12.1.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.1.1",
    "@sentry/nestjs": "^11.1.0",
    "axios": "^1.18.1",
    "better-auth": "1.6.25",
    "bullmq": "^5.81.2",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "csrf-csrf": "^4.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.2.2",
    "mysql2": "^3.23.1",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "^5.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.3",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.0",
    "@compodoc/compodoc": "^2.0.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25"
  }
}
