{
  "name": "gnester-lite",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"src/config/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"src/config/**/*.{yml,yaml}\" \"scripts/**/*.mjs\" \"docs/**/*.md\" \"prompts/**/*.md\" \"README.md\" \"AGENTS.md\" \"CLAUDE.md\" \"*.json\" \"*.{yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "start": "NODE_ENV=development nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "start:repl": "NODE_ENV=development nest start --watch --entryFile repl",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "pnpm run typecheck:build && pnpm run typecheck:test",
    "typecheck:build": "tsc --project tsconfig.build.json --noEmit --incremental false",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit --incremental false",
    "verify:artifact": "node scripts/verify-build-artifact.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:container-references": "node scripts/verify-container-references.mjs",
    "verify:docker-image": "node scripts/verify-docker-image.mjs",
    "verify:openapi": "node scripts/verify-openapi-document.mjs",
    "verify:shutdown-contract": "node scripts/verify-shutdown-contract.mjs",
    "verify:migrations": "node scripts/run-destructive-integration.mjs migrations",
    "verify:production-start": "node scripts/run-destructive-integration.mjs production-start",
    "audit:prod": "pnpm audit --prod",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/typeorm.data-source.ts",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:run:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/src/config/typeorm.data-source.js migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:revert:prod": "NODE_ENV=production node node_modules/typeorm/cli.js -d dist/src/config/typeorm.data-source.js migration:revert",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "peers:check": "pnpm peers check",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:full-app": "node scripts/run-destructive-integration.mjs full-app",
    "test:integration-policy": "node --test scripts/run-destructive-integration.test.mjs",
    "compodoc": "compodoc -p tsconfig.compodoc.json -d documentation --silent",
    "compodoc:serve": "compodoc -p tsconfig.compodoc.json -d documentation -s"
  },
  "dependencies": {
    "@keyv/redis": "catalog:",
    "@nestjs/axios": "catalog:",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/cache-manager": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/event-emitter": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-socket.io": "catalog:",
    "@nestjs/schedule": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@sentry/nestjs": "catalog:",
    "axios": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "catalog:",
    "cache-manager": "catalog:",
    "class-transformer": "catalog:",
    "class-validator": "catalog:",
    "compression": "catalog:",
    "cookie-parser": "catalog:",
    "cron": "catalog:",
    "csrf-csrf": "catalog:",
    "express": "catalog:",
    "express-session": "catalog:",
    "helmet": "catalog:",
    "js-yaml": "catalog:",
    "mysql2": "catalog:",
    "nestjs-i18n": "catalog:",
    "nestjs-pino": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "passport-local": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "socket.io": "catalog:",
    "typeorm": "catalog:"
  },
  "devDependencies": {
    "@asyncapi/parser": "catalog:",
    "@compodoc/compodoc": "catalog:",
    "@eslint/eslintrc": "catalog:",
    "@eslint/js": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/compression": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/express": "catalog:",
    "@types/express-session": "catalog:",
    "@types/jest": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/passport-jwt": "catalog:",
    "@types/passport-local": "catalog:",
    "@types/supertest": "catalog:",
    "chokidar": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "pino-pretty": "catalog:",
    "prettier": "catalog:",
    "socket.io-client": "catalog:",
    "supertest": "catalog:",
    "ts-node": "catalog:",
    "tsconfig-paths": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "jest": {
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "moduleNameMapper": {
      "^config/(.*)$": "<rootDir>/src/config/$1",
      "^\\./better-auth\\.loader\\.cjs$": "<rootDir>/test/fixtures/better-auth-loader.mock.cjs",
      "^better-auth$": "<rootDir>/test/fixtures/better-auth.mock.cjs",
      "^better-auth/node$": "<rootDir>/test/fixtures/better-auth-node.mock.cjs"
    },
    "transform": {
      "^.+\\.(t|j)s?$": [
        "@swc/jest"
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!src/metadata.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 40,
        "functions": 70,
        "lines": 75,
        "statements": 70
      },
      "./src/bootstrap/http/validation.pipe.ts": {
        "branches": 80,
        "functions": 100,
        "lines": 90,
        "statements": 90
      },
      "./src/i18n/api-envelope.interceptor.ts": {
        "branches": 50,
        "functions": 100,
        "lines": 85,
        "statements": 85
      },
      "./src/i18n/api-exception.filter.ts": {
        "branches": 60,
        "functions": 90,
        "lines": 80,
        "statements": 80
      },
      "./src/i18n/i18n.translate.ts": {
        "branches": 60,
        "functions": 85,
        "lines": 85,
        "statements": 85
      }
    },
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.1.2"
}
