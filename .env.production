NODE_ENV=production

PORT=3000

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=pro
DB_SYNCHRONIZE=false
DB_AUTO_LOAD_ENTITIES=true
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY=3000

# Redis
REDIS_URL=redis://localhost:6379

# Sentry (optional — empty DSN keeps Sentry off)
SENTRY_DSN=
SENTRY_ENABLED=true
# SENTRY_TRACES_SAMPLE_RATE=0.1
