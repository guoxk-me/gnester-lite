# Runtime
NODE_ENV=development
PORT=3000
# BIND_HOST=127.0.0.1 (optional; restricts local development to loopback)

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# DB_PASSWORD=
DB_DATABASE=test
DB_SYNCHRONIZE=false
DB_AUTO_LOAD_ENTITIES=true
DB_RETRY_ATTEMPTS=10
DB_RETRY_DELAY=3000

# Redis
REDIS_URL=redis://localhost:6379

# Smart Assistant (server only)

# CORS
CORS_ENABLED=true
# CORS_ORIGINS=https://app.example.com
CORS_CREDENTIALS=true
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=content-type,authorization,X-XSRF-TOKEN
# CORS_EXPOSED_HEADERS=x-request-id
CORS_MAX_AGE=600
CORS_OPTIONS_SUCCESS_STATUS=204

# Cookies and compression
# COOKIE_SECRET=development-cookie-secret-at-least-32-bytes
COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD=1kb
COMPRESSION_LEVEL=6

# CSRF
CSRF_ENABLED=true
# Generate independently: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# CSRF_SECRET=<generated-secret>
CSRF_IDENTIFIER_COOKIE_NAME=gnester.csrf-id
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAME_SITE=lax

# Authentication and cryptography
# Generate each secret independently. Never copy values between variables.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=<generated-48-byte-base64url-secret>
# Reusable bearer JWT lifetime; browser application access cookies are fixed at 15 minutes.
JWT_ACCESS_TOKEN_TTL=15m
JWT_ISSUER=gnester-lite
JWT_AUDIENCE=gnester-lite
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ENCRYPTION_KEY=<generated-32-byte-base64url-key>
# HMAC_SECRET=<generated-48-byte-base64url-secret>

# Logging and monitoring
LOGGER_JSON=true
LOGGER_LEVELS=log,error,warn,debug,verbose
# SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
SENTRY_ENABLED=false
SENTRY_TRACES_SAMPLE_RATE=0.1
